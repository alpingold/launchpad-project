# The server's settings in production. Copied to /etc/boilergames.env (see deploy/README.md).
# Everything not set here uses the default in server/src/config.js.

NODE_ENV=production
# Only Caddy talks to the server, on this port, on this machine (HOST): it's not reachable
# from the internet even if a firewall rule were wrong.
PORT=3000
HOST=127.0.0.1
# Trust the visitor's IP from Caddy (on the same machine), for the login attempt limit.
TRUST_PROXY=loopback
# AI generation (plan §11, §15): needs Docker + OpenShell set up on this machine (README step 6).
# Leave it out (or 0) to run the site without it.
GENERATION_ENABLED=1
# Games made at the same time (the rest wait in line). Their browser checks take turns:
# GENERATION_BROWSER_CHECKS at once. These suit a 2 GB / 2-CPU server.
GENERATION_MAX_RUNNING=4
GENERATION_BROWSER_CHECKS=1
