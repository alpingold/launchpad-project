# The server's settings, installed as /etc/boilergames.env. Nothing here is secret.
NODE_ENV=production
# Only Caddy, on the same machine, talks to the Node process.
HOST=127.0.0.1
PORT=3000
FRAME_PORT=3001
# The address people type, and the game domain's frame page. Sockets from any other page are refused.
SITE_ORIGIN=https://boilergames.party
FRAME_URL=https://boilergames-play.party/v1/
# Behind Caddy every request comes from 127.0.0.1; the visitor's address is the one Caddy appends.
TRUST_PROXY=1
# Sized for a 2 GB server: about 8.3 MB a Room at worst (see the README's limits).
MAX_ROOMS=120
