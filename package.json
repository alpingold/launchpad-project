{
  "name": "boilergames",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "sdk",
    "protocol",
    "server",
    "client"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build -w @boilergames/client",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "dev": "tsc -b tsconfig.build.json && node scripts/dev.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
