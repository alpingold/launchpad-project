{
  "name": "boilergames",
  "private": true,
  "description": "Root scripts only. The server and client are separate programs with their own package.json.",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install && npm --prefix e2e install && npm --prefix generator install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test:e2e": "npm --prefix e2e test",
    "admin": "node server/scripts/admin.js",
    "schema": "node server/scripts/schema.js",
    "generate": "node server/scripts/generate.js",
    "compare-builds": "node server/scripts/compare-builds.js",
    "check-game": "node generator/src/check/cli.js",
    "test:check": "npm --prefix generator test"
  }
}
