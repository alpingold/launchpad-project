{
  "name": "boilergames",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "sdk",
    "protocol",
    "server",
    "client",
    "games",
    "playtest"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build -w @boilergames/client && npm run build -w @boilergames/games && npm run check-built -w @boilergames/sdk && npm run check-built -w @boilergames/playtest",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -b tsconfig.build.json && node scripts/dev.js",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "router": "2.2.0",
    "encodeurl": "2.0.1"
  }
}
