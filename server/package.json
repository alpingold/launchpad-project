{
  "name": "@boilergames/server",
  "description": "The one server process: HTTP, WebSockets, Rooms and the database.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@boilergames/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@boilergames/protocol": "*",
    "@boilergames/sdk": "*",
    "express": "5.3.0",
    "ws": "8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/ws": "8.18.2"
  }
}
