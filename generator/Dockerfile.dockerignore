# Allow-list: ignore everything, then let in only what generator/Dockerfile copies.
# (Docker uses this file instead of a root .dockerignore when building generator/Dockerfile.)
*
!server/package.json
!server/src
!generator/package.json
!generator/package-lock.json
!generator/src
!generator/spec
!generator/templates
!client/src/game/frame
!client/public/game-assets
