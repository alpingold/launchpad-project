# One Playtest runner, started by boilergames-playtest.socket for one connection. It runs a
# stranger's code, so it runs where that code can reach nothing: this file is the wall (BUILD-PLAN
# Step 13). deploy/attack-playtest.sh attacked it on a throwaway server on 2026-11-18 and all 31
# attacks were contained. Run that again, the same way, after any change to this file.
#
# What a Game's code could try, and what stops it:
# - the network: a network of its own with nothing in it, no IP traffic, and no sockets but Unix ones;
# - the site's secrets and data: all of /var is an empty folder (the database, Caddy's TLS keys,
#   every log), and the settings file, home folders, /boot, /snap, Caddy's, SSH's and the AWS
#   Systems Manager agent's settings can't be seen at all; other processes are invisible in /proc;
# - leaving something behind: a new user for each run (DynamicUser), the whole file system read-only
#   but for an empty /tmp of its own, gone when the run ends;
# - taking over the machine: no privileges, no capabilities, only ordinary system calls, and caps on
#   memory, processes and threads, CPU and time, and every run at once shares one budget
#   (boilergames-playtest.slice).
#
# The runner must be able to start tsc, TypeScript's compiler, which is a program of its own, so
# starting programs can't be forbidden. A program the Game starts is inside this same wall, with
# the same user, limits and view, and dies with the run.
[Unit]
Description=BoilerGames Playtest runner (one Playtest, walled)

[Service]
# Node's own heap stops below the run's memory cap (MemoryMax below), leaving room for tsc.
ExecStart=/usr/local/bin/node --max-old-space-size=192 /opt/boilergames/current/playtest/dist/runner.js
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=NODE_ENV=production
# Thread pools sized for the server's two cores, not every core the machine reports: Node's, Go's
# (tsc) and Rust's (Vite's bundler). Each thread counts against TasksMax.
Environment=UV_THREADPOOL_SIZE=2 GOMAXPROCS=2 RAYON_NUM_THREADS=2

# Every run shares one budget with the others (CPU, memory, tasks), beside the site.
Slice=boilergames-playtest.slice

# Its own user, new for every run. Implies ProtectSystem=strict, ProtectHome=read-only, PrivateTmp,
# RemoveIPC, NoNewPrivileges and RestrictSUIDSGID.
DynamicUser=yes

# What it can see of the disk. Everything is read-only (ProtectSystem=strict), and what it has no
# need to read is hidden. It needs only Node (/usr/local/bin/node, a link into /opt/node-*), the
# release (/opt/boilergames/current, a link into /opt/boilergames/releases), /usr, /lib and /etc's
# ordinary files, and the empty /tmp of its own. So /opt stays, read-only: Node lives there, and the
# releases hold nothing that isn't on GitHub.
ProtectSystem=strict
# An empty, read-only /var of its own: the database (/var/lib/boilergames), Caddy's TLS keys
# (/var/lib/caddy), the Systems Manager agent's state and logs (/var/lib/amazon, /var/snap,
# /var/log), and anything else that is ever put there, all gone at once. Only its private /var/tmp
# (PrivateTmp below) appears in it.
TemporaryFileSystem=/var:ro
# /home, /root and /run/user: not there at all.
ProtectHome=yes
# The rest it has no need to read: not there at all. ("-": fine if one doesn't exist.) The site's
# settings; the boot files; snaps (the Systems Manager agent is one on Ubuntu); Caddy's, SSH's and
# the Systems Manager agent's settings; and /dev/shm, the shared-memory folder, which the server's
# other programs share and a run could otherwise write to (found by the attack run, 2026-11-18).
InaccessiblePaths=-/etc/boilergames.env -/etc/boilergames-key-secret -/boot -/snap -/etc/caddy -/etc/ssh -/etc/amazon /dev/shm
# /tmp and /var/tmp: empty, its own, and gone when the run ends.
PrivateTmp=yes
UMask=0077
# Other processes (and so /proc/1/environ) can't be seen.
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
PrivateIPC=yes

# No network: a network namespace with only an unused loopback, no IP traffic even so, and no
# socket families but Unix (the connection itself, and pipes to tsc).
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# No privileges and no way to get any.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
# A system call outside the list fails, rather than killing the run with no result.
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Never MemoryDenyWriteExecute: V8, which runs JavaScript, writes the machine code it runs.

# Limits for this one run; boilergames-playtest.slice caps every run at once. Measured on a
# developer's machine (x86, the Official games): a Playtest took 0.4 to 1.2 s, peaked at 74 to 81 MB
# for Node and tsc together, and had about 20 threads on two cores with the pool sizes above (45 with
# every one of 16 cores). The caps leave room for a large Game, not for an attack.
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
CPUQuota=100%
RuntimeMaxSec=60
