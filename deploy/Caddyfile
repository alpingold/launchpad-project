# Caddy: the front door (plan M8). It gets and renews the HTTPS certificate by itself, and
# passes everything, WebSockets included (/ws becomes wss://), to the Node server.
# The site's address. Caddy asks Let's Encrypt for its certificate on first start.
boilergames.party {
	encode zstd gzip
	# 127.0.0.1, not "localhost": Node listens on IPv4 only (HOST=127.0.0.1).
	reverse_proxy 127.0.0.1:3000
}
