# The server's settings in production. Copied to /etc/boilergames.env (see deploy/README.md).
# Everything not set here uses the default in server/src/config.js.

NODE_ENV=production
# Only Caddy talks to the server, on this port; it's not open to the internet.
PORT=3000
# Trust the visitor's IP from Caddy (on the same machine), for the login attempt limit.
TRUST_PROXY=loopback
# AI generation (plan §11, §15): needs Docker + OpenShell set up on this machine (README step 6).
# Leave it out (or 0) to run the site without it.
GENERATION_ENABLED=1
